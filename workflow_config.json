{
  "workflows": {
    "publish_homework": {
      "name": "发布作业",
      "description": "自动发布作业流程",
      "steps": [
        { "action": "launch", "package": "com.zpzn.terminal", "wait": 7, "desc": "打开应用" },
        { "action": "tap", "x": 370, "y": 600, "wait": 3, "desc": "点击登录入口" },
        { "action": "tap", "x": 1800, "y": 70, "wait": 3, "desc": "教师登录" },
        { "action": "tap", "x": 1230, "y": 426, "wait": 0.5, "desc": "点击账号输入框" },
        { "action": "clear", "wait": 0.3, "desc": "清除账号内容" },
        { "action": "input", "text": "${username}", "wait": 0.5, "desc": "输入账号" },
        { "action": "key", "key": "enter", "wait": 0.5, "desc": "按回车" },
        { "action": "tap", "x": 1230, "y": 540, "wait": 0.5, "desc": "点击密码输入框" },
        { "action": "clear", "wait": 0.3, "desc": "清除密码内容" },
        { "action": "input", "text": "${password}", "wait": 0.5, "desc": "输入密码" },
        { "action": "key", "key": "enter", "wait": 0.5, "desc": "按回车" },
        { "action": "tap", "x": 960, "y": 670, "wait": 3, "desc": "点击登录按钮" },
        { "action": "tap", "x": 400, "y": 560, "wait": 2, "desc": "进入发布界面" },
        { "action": "tap", "x": 870, "y": 379, "wait": 1, "desc": "选择页码按钮" },
        { "action": "tap", "x": 659, "y": 233, "wait": 0.5, "desc": "页码选择器" },
        { "action": "tap", "x": 830, "y": 230, "wait": 0.5, "desc": "页码确认" },
        { "action": "tap", "x": 950, "y": 900, "wait": 1, "desc": "确认页码" },
        { "action": "tap", "x": 833, "y": 557, "wait": 0.5, "desc": "点击作业名称输入框" },
        { "action": "input", "text": "${homework_name}", "wait": 0.5, "desc": "输入作业名称" },
        { "action": "key", "key": "enter", "wait": 0.5, "desc": "关闭键盘" },
        { "action": "tap", "x": 960, "y": 960, "wait": 3, "desc": "确认发布" }
      ],
      "params": {
        "username": { "type": "string", "default": "shuxue", "label": "账号" },
        "password": { "type": "string", "default": "123456zp.", "label": "密码" },
        "homework_name": { "type": "string", "default": "", "label": "作业名称" }
      }
    },
    "submit_homework": {
      "name": "提交作业",
      "description": "自动提交作业流程（需先选择班级）",
      "steps": [
        { "action": "launch", "package": "com.zpzn.terminal", "wait": 5, "desc": "打开应用" },
        { "action": "tap", "x": 1200, "y": 400, "wait": 2, "desc": "进入提交界面" },
        { "action": "rfid", "target": "rep", "wait": 2, "desc": "刷课代表卡" },
        { "action": "tap", "x": 400, "y": 551, "wait": 1, "desc": "点击双页模式" },
        { "action": "tap", "x": 667, "y": 978, "wait": 2, "desc": "拍照" },
        { "action": "loop", "target": "students", "steps": [
          { "action": "rfid", "target": "current", "wait": 1, "desc": "刷学生卡" },
          { "action": "tap", "x": 667, "y": 978, "wait": "${photo_interval}", "desc": "拍照" }
        ], "desc": "循环处理学生" },
        { "action": "tap", "x": 1593, "y": 955, "wait": 2, "desc": "点击提交" },
        { "action": "tap", "x": 886, "y": 781, "wait": 3, "desc": "确认提交" }
      ],
      "params": {
        "photo_interval": { "type": "number", "default": 2, "label": "拍照间隔(秒)" }
      }
    }
  },
  "atom_actions": {
    "tap": { "name": "点击坐标", "params": ["x", "y"] },
    "tap_element": { "name": "点击元素", "params": ["text", "resource_id", "content_desc", "partial_match", "retry"] },
    "wait_element": { "name": "等待元素", "params": ["text", "resource_id", "timeout"] },
    "input_to_element": { "name": "输入到元素", "params": ["text", "resource_id", "input_text"] },
    "long_press": { "name": "长按", "params": ["x", "y", "duration"] },
    "swipe": { "name": "滑动", "params": ["x1", "y1", "x2", "y2", "duration"] },
    "input": { "name": "输入文本", "params": ["text"] },
    "clear": { "name": "清除输入", "params": [] },
    "key": { "name": "按键", "params": ["key"] },
    "wait": { "name": "等待", "params": ["seconds"] },
    "launch": { "name": "启动应用", "params": ["package"] },
    "stop_app": { "name": "停止应用", "params": ["package"] },
    "screenshot": { "name": "截图", "params": [] },
    "rfid": { "name": "刷RFID卡", "params": ["target"] },
    "loop": { "name": "循环", "params": ["target", "steps"] }
  }
}
